{
  "name": "cafu-gym-backend",
  "version": "1.0.0",
  "description": "REST API CAFU GYM (Express.js + MySQL/MariaDB + JWT)",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "migrate": "node src/migrations/run.js",
    "migrate:fresh": "node src/migrations/run.js --fresh",
    "seed": "node src/seed.js",
    "test": "node scripts/smoke-test.js"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0"
  }
}
