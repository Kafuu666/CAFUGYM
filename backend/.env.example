PORT=5000
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cafu_gym

# Ganti dengan string acak panjang (contoh: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=7d

# QRIS: true  = member yang memilih QRIS langsung dianggap lunas (simulasi, tanpa payment gateway).
#       false = pembayaran QRIS menunggu konfirmasi admin (cek notifikasi/mutasi QRIS dulu). Disarankan untuk produksi.
QRIS_AUTO_CONFIRM=true
