# Kosongkan saat development (memakai proxy Vite ke http://localhost:5000).
# Saat production isi alamat API lengkap, contoh: https://api.contoh.com/api
VITE_API_URL=/api

# Gambar QRIS yang ditampilkan ke member. Default: /qris.svg (contoh). Ganti file frontend/public/qris.svg
# dengan QRIS gym Anda, atau arahkan ke gambar lain (mis. /qris.png).
VITE_QRIS_IMAGE=/qris.svg
